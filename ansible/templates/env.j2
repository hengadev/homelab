# Environment variables for Docker Compose on server
# Generated by Ansible - contains only Docker Compose scoped variables

DOMAIN={{ domain }}
ADMIN_TOKEN={{ admin_token }}
ADMIN_EMAIL={{ admin_email }}
BACKUP_AWS_ACCESS_KEY_ID={{ backup_aws_access_key_id }}
BACKUP_AWS_SECRET_ACCESS_KEY={{ backup_aws_secret_access_key }}
AWS_DEFAULT_REGION={{ aws_default_region }}
BACKUP_S3_BUCKET={{ backup_s3_bucket }}
BACKUP_PASSPHRASE={{ backup_passphrase }}
GITHUB_USERNAME={{ github_username }}
ANKI_SYNC_USER1={{ anki_username }}:{{ anki_password }}
ANKI_API_KEY={{ anki_api_key }}

# Leviosa demo credentials
LEVIOSA_DEMO_ADMIN_EMAIL={{ leviosa_demo_admin_email }}
LEVIOSA_DEMO_ADMIN_PASSWORD={{ leviosa_demo_admin_password }}
LEVIOSA_DEMO_PARTNER_EMAIL={{ leviosa_demo_partner_email }}
LEVIOSA_DEMO_PARTNER_PASSWORD={{ leviosa_demo_partner_password }}
LEVIOSA_DEMO_CLIENT_EMAIL={{ leviosa_demo_client_email }}
LEVIOSA_DEMO_CLIENT_PASSWORD={{ leviosa_demo_client_password }}

# =============================================================================
# Woodpecker CI
# =============================================================================

WOODPECKER_ADMIN={{ woodpecker_admin }}
WOODPECKER_GITHUB_CLIENT={{ woodpecker_github_client }}
WOODPECKER_GITHUB_SECRET={{ woodpecker_github_secret }}
WOODPECKER_AGENT_SECRET={{ woodpecker_agent_secret }}

# =============================================================================
# Infisical (secrets manager)
# =============================================================================

INFISICAL_DB_PASSWORD={{ infisical_db_password }}
INFISICAL_ENCRYPTION_KEY={{ infisical_encryption_key }}
INFISICAL_AUTH_SECRET={{ infisical_auth_secret }}
