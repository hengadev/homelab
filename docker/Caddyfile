vault.{$DOMAIN} {
    # Since Vaultwarden 1.31.0, WebSocket notifications (/notifications/hub)
    # are served on the main HTTP port, not a separate 3012 — reverse_proxy
    # upgrades to WebSocket automatically on Connection/Upgrade headers.
    reverse_proxy vaultwarden:80
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy no-referrer
    }
}

